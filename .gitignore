# Data (read-only, never commit)
# Which instruction files loaded, written by the InstructionsLoaded hook. Local
# evidence about this machine's session, not a fact about the project.
.claude/instructions-loaded.log

# data/* rather than data/, because git cannot re-include anything below an
# excluded directory — the exceptions underneath would be dead letters.
data/*
!data/.gitkeep

# data/external/ holds machine-downloaded artifacts. The artifacts themselves
# stay out of git (large, and re-downloadable by definition), but its manifest
# and README must be tracked: the manifest is the record that makes a download
# reproducible, and H10 copies its checksums into every run's provenance. An
# untracked manifest would leave results traceable only on the machine that
# produced them, which is the opposite of the point.
!data/external/
data/external/*
!data/external/README.md
!data/external/manifest.json

# Secrets
.env
.env.*
*.pem
*.key

# Logs & results
logs/
results/

# Snakemake working state (derived; regenerated on every run)
.snakemake/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Cache
data/cache/
.cache/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
junit.xml
htmlcov/

# Type checking
.mypy_cache/
.ruff_cache/

# Claude Code (local-only; .claude/settings.json and .claude/agents/ ARE committed)
.claude/settings.local.json
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Roadmap H7: the suite receipt is local evidence about this machine, not
# a project artifact. Committing it would let one machine vouch for another.
reports/last-suite.json
