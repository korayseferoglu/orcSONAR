{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-bash-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking the shell touches no data"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-data-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking data/ is untouched"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-results-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking results/ is untouched"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-print-in-src.py\"",
            "timeout": 10,
            "statusMessage": "Checking for print() in src/"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/log-instructions-loaded.py\"",
            "timeout": 10,
            "statusMessage": "Recording which instruction files loaded"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/ruff-check-src.py\"",
            "timeout": 40,
            "statusMessage": "ruff check"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(python3 .claude/skills/verify-run/scripts/verify_run.py *)"
    ]
  },
  "enabledPlugins": {
    "pubmed@life-sciences": true
  }
}
