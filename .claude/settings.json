{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-bash-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking the shell touches no data"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-data-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking data/ is untouched"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-results-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking results/ is untouched"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-print-in-src.py\"",
            "timeout": 10,
            "statusMessage": "Checking for print() in src/"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-prereg-writes.py\"",
            "timeout": 10,
            "statusMessage": "Checking the pre-registration lock"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/log-instructions-loaded.py\"",
            "timeout": 10,
            "statusMessage": "Recording which instruction files loaded"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-status.py\"",
            "timeout": 60,
            "statusMessage": "Measuring where the project stands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/ruff-check-src.py\"",
            "timeout": 40,
            "statusMessage": "ruff check"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/mypy-check-src.py\"",
            "timeout": 95,
            "statusMessage": "mypy (bilgilendirici)"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/config-key-wired.py\"",
            "timeout": 60,
            "statusMessage": "Checking config keys are wired"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-summary.py\"",
            "timeout": 20,
            "statusMessage": "Summarising what is left uncommitted"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(python3 .claude/skills/verify-run/scripts/verify_run.py *)"
    ]
  },
  "enabledPlugins": {
    "pubmed@life-sciences": true
  }
}
